{
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "postgres",
        "uid": "Zabbix_DB"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "basemap": {
          "type": "xyz",
          "name": "OSM Libre",
          "config": {
            "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            "attribution": "© OpenStreetMap contributors"
          }
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": { "fixed": "green" },
                "opacity": 0.8,
                "size": { "fixed": 8 },
                "symbol": { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" }
              }
            },
            "location": { "mode": "auto" },
            "name": "Equipos Sanos",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": { "mode": "details" },
        "view": {
          "id": "coords",
          "lat": -27.451123,
          "lon": -58.986540,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "Zabbix_DB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT h.name as host, '-27.451123' as latitude, '-58.986540' as longitude, 1 as status FROM hosts h WHERE h.status = 0;",
          "refId": "A"
        }
      ],
      "title": "Mapa de Enlaces - Resistencia",
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": { "filter": "/.*/" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "/.*ICMP ping.*/" },
          "options": { "showPoints": false },
          "queryType": 0
        }
      ],
      "title": "Alertas y Triggers (Problemas)",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "left",
            "displayMode": "color-background",
            "inspect": false
          },
          "mappings": [
            {
              "options": {
                "1": { "color": "green", "index": 0, "text": "UP (Activo)" },
                "2": { "color": "red", "index": 1, "text": "DOWN (Caído)" },
                "3": { "color": "orange", "index": 2, "text": "TESTING" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "gray", "value": null },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Puerto" },
            "properties": [
              { "id": "custom.displayMode", "value": "auto" }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 3,
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": { "filter": "/.*/" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "/.*(status|Status|estado|Estado|Link|link|Ping|ping|Uptime|uptime|Oper).*/" },
          "options": { "showPoints": false },
          "queryType": 0
        }
      ],
      "title": "Estado de Interfaces Físicas (Puertos)",
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": [ "last" ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Field": "Puerto",
              "Last": "Estado del Enlace"
            }
          }
        }
      ],
      "type": "table"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Zabbix",
          "value": "Zabbix"
        },
        "hide": 2,
        "name": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Monitor de Enlaces"
}
