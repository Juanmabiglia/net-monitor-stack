{
  "editable": true,
  "panels": [
    {
      "datasource": {
        "type": "postgres",
        "uid": "Zabbix_DB"
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "basemap": {
          "type": "xyz",
          "name": "OSM Libre",
          "config": {
            "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            "attribution": "© OpenStreetMap contributors"
          }
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showScale": true,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "showLegend": true,
              "style": {
                "color": { "fixed": "green" },
                "opacity": 0.8,
                "size": { "fixed": 8 },
                "symbol": { "fixed": "img/icons/marker/circle.svg", "mode": "fixed" }
              }
            },
            "location": { "mode": "auto" },
            "name": "Equipos Sanos",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": { "mode": "details" },
        "view": {
          "id": "coords",
          "lat": -27.451123,
          "lon": -58.986540,
          "zoom": 12
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "Zabbix_DB"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT h.name as host, CAST(hi.location_lat AS double precision) as latitude, CAST(hi.location_lon AS double precision) as longitude, 1 as status FROM hosts h JOIN host_inventory hi ON h.hostid = hi.hostid WHERE h.status = 0 AND hi.location_lat <> '';",
          "refId": "A"
        }
      ],
      "title": "Mapa de Enlaces - Resistencia",
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "alexanderzobnin-zabbix-datasource",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "datasource": {
            "type": "alexanderzobnin-zabbix-datasource",
            "uid": "${datasource}"
          },
          "group": { "filter": "/.*/" },
          "host": { "filter": "/.*/" },
          "item": { "filter": "/.*ICMP ping.*/" },
          "options": { "showPoints": false },
          "queryType": 0
        }
      ],
      "title": "Alertas y Triggers (Problemas)",
      "type": "state-timeline"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Zabbix",
          "value": "Zabbix"
        },
        "hide": 2,
        "name": "datasource",
        "query": "alexanderzobnin-zabbix-datasource",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Monitor de Enlaces"
}
